{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-engine#compile": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-tools#compile": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-cut#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile", "@neko/webview#build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-canvas#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-model#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "@neko/cli#build:exe": {
      "dependsOn": ["@neko/agent#build", "@neko/shared#build"],
      "outputs": ["../../neko"],
      "cache": true
    },
    "neko-agent#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile", "@neko/cli#build:exe"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-audio#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-assets#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-live#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-story#compile": {
      "dependsOn": ["neko-engine#compile", "neko-tools#compile"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "neko-sketch#compile": {
      "dependsOn": [],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
