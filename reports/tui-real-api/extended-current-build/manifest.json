{
  "schema": "neko.tui-real-api-suite.v1",
  "name": "extended-current-build-real-api-validation",
  "description": "Extended current-build real API validation for baseline prompts, media generation, skill fixtures, and long-running multi-step workflows.",
  "defaults": {
    "workDir": "/Users/feng/Git/neko-test",
    "maxIterations": 12,
    "timeoutMs": 240000,
    "stream": false
  },
  "cases": [
    {
      "id": "prompt-cn-brief",
      "promptId": "base-prompt-cn",
      "description": "Baseline Chinese prompt adherence.",
      "prompt": "不要调用工具。请用一句中文回答，并必须包含标记 BASIC_PROMPT_CN_OK：TUI real API 基础提示词测试在验证什么？",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "non-empty-output" },
        { "kind": "output-contains", "text": "BASIC_PROMPT_CN_OK" }
      ]
    },
    {
      "id": "prompt-json-contract",
      "promptId": "base-prompt-json",
      "description": "Structured output prompt adherence.",
      "prompt": "不要调用工具。只输出一个 JSON 对象，不要 Markdown 代码块。JSON 必须包含：\"marker\":\"BASIC_PROMPT_JSON_OK\"、\"ok\":true、\"language\":\"zh-CN\"。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "output-contains", "text": "BASIC_PROMPT_JSON_OK" },
        { "kind": "output-not-contains", "text": "```" }
      ]
    },
    {
      "id": "prompt-tool-restraint",
      "promptId": "base-prompt-no-tool",
      "description": "No-tool instruction adherence.",
      "prompt": "不要调用任何工具。直接用中文一句话回答，并必须包含标记 NO_TOOL_PROMPT_OK。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "output-contains", "text": "NO_TOOL_PROMPT_OK" },
        { "kind": "output-not-contains", "text": "[tool]" }
      ]
    },
    {
      "id": "workspace-file-reference",
      "promptId": "workspace-reference",
      "description": "Workspace file reference and Read tool behavior.",
      "prompt": "@cases/test.fountain 请读取这个工作区文件，说明文件类型，并必须包含标记 WORKSPACE_FILE_OK 和一条真实内容证据。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "content-evidence", "text": "Read" },
        { "kind": "output-contains", "text": "WORKSPACE_FILE_OK" }
      ]
    },
    {
      "id": "media-image-generation-submit",
      "promptId": "media-image-generation",
      "description": "GenerateImage tool submission through the current configured image model.",
      "prompt": "请调用 GenerateImage 工具提交一张 1:1 图片生成任务，主题是“干净白底上的 Neko 测试徽章，包含小字 EXTENDED_REAL_API_MEDIA_OK”。提交后用中文说明任务已提交，并必须包含标记 MEDIA_IMAGE_SUBMIT_OK 和 taskId。不要说图片已经完成。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "content-evidence", "text": "GenerateImage" },
        { "kind": "output-contains", "text": "MEDIA_IMAGE_SUBMIT_OK" },
        { "kind": "output-contains", "text": "taskId" }
      ]
    },
    {
      "id": "epub-vision-two-pages",
      "promptId": "epub-vision",
      "description": "EPUB document-entry image projection and vision-capable model behavior.",
      "requiredCapabilities": ["vision"],
      "prompt": "@${A}/epub/animation/Blame/[Kmoe][BLAME！(新裝版)]卷01.epub 分析前2页内容。必须按 ReadDocument -> ReadImage 的顺序读取图片证据，并在回答中包含标记 EPUB_VISION_OK、图片总数、前2页 entryPath 和尺寸。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "model-capability", "capability": "vision", "expected": true },
        { "kind": "content-evidence", "text": "ReadDocument" },
        { "kind": "content-evidence", "text": "ReadImage" },
        { "kind": "output-contains", "text": "EPUB_VISION_OK" }
      ]
    },
    {
      "id": "skill-direct-strict-format",
      "promptId": "skill-direct",
      "description": "Direct $skill lifecycle activation from workspace .neko/skills.",
      "workDir": "/Users/feng/Git/neko-suite/reports/tui-real-api/extended-current-build/workspace",
      "prompt": "$strict-format 请确认当前 skill 是否通过 TUI skill lifecycle 生效。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "output-contains", "text": "SKILL_STRICT_FORMAT_ACTIVE" }
      ]
    },
    {
      "id": "skill-tool-reading",
      "promptId": "skill-tool",
      "description": "Skill with allowed tool reads a fixture file.",
      "workDir": "/Users/feng/Git/neko-suite/reports/tui-real-api/extended-current-build/workspace",
      "prompt": "$tool-reading 请读取 skill-fixture.txt 并报告证据。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "content-evidence", "text": "Read" },
        { "kind": "output-contains", "text": "SKILL_TOOL_READING_ACTIVE" },
        { "kind": "output-contains", "text": "SKILL_FIXTURE_FILE_OK" }
      ]
    },
    {
      "id": "skill-command-artifact",
      "promptId": "skill-command",
      "description": "Slash command artifact loaded from workspace .neko/commands.",
      "workDir": "/Users/feng/Git/neko-suite/reports/tui-real-api/extended-current-build/workspace",
      "prompt": "/fixture-review TUI 命令型 skill 配置测试",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "output-contains", "text": "COMMAND_ARTIFACT_ACTIVE" }
      ]
    },
    {
      "id": "skill-disabled-visible-error",
      "promptId": "skill-disabled",
      "description": "Disabled skill must fail visibly instead of running.",
      "workDir": "/Users/feng/Git/neko-suite/reports/tui-real-api/extended-current-build/workspace",
      "prompt": "$disabled-fixture 请运行。",
      "checks": [
        { "kind": "exit-code", "equals": 1 },
        { "kind": "error-contains", "text": "disabled" }
      ]
    },
    {
      "id": "long-multistep-workflow",
      "promptId": "long-task",
      "description": "Long-running multi-step workflow with read/write/readback evidence.",
      "workDir": "/Users/feng/Git/neko-suite/reports/tui-real-api/extended-current-build/workspace",
      "maxIterations": 16,
      "timeoutMs": 300000,
      "prompt": "执行一个多步骤长任务，不要只单轮回答：1. 读取 long-source.md；2. 根据内容写入 long-output.md，包含标题、三条要点和标记 LONG_TASK_REPORT_OK；3. 再读取 long-output.md 校验；4. 最后用中文总结，并必须包含标记 LONG_TASK_OK、LONG_SOURCE_FIXTURE_OK、LONG_TASK_REPORT_OK。",
      "checks": [
        { "kind": "exit-code", "equals": 0 },
        { "kind": "content-evidence", "text": "Read" },
        { "kind": "content-evidence", "text": "Write" },
        { "kind": "output-contains", "text": "LONG_TASK_OK" },
        { "kind": "output-contains", "text": "LONG_SOURCE_FIXTURE_OK" },
        { "kind": "output-contains", "text": "LONG_TASK_REPORT_OK" }
      ]
    }
  ]
}
