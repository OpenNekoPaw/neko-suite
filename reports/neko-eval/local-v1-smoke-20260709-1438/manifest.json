{
  "schema": "neko.eval.v1",
  "name": "local-v1-eval-smoke",
  "defaults": {
    "workDir": "/Users/feng/Git/neko-suite",
    "model": "gpt-5.5",
    "maxIterations": 4,
    "timeoutMs": 180000,
    "stream": false,
    "controllerModel": {
      "model": "gpt-5.5",
      "maxTokens": "<redacted>",
      "temperature": 0.2
    },
    "judgeModel": {
      "model": "gpt-5.5",
      "maxTokens": "<redacted>",
      "temperature": 0
    },
    "retry": {
      "maxAttemptsPerTurn": 1,
      "maxConsecutiveErrors": 1
    }
  },
  "cases": [
    {
      "id": "single-baseline",
      "mode": "single",
      "checks": [
        {
          "kind": "success"
        },
        {
          "kind": "model-used",
          "provider": "nekoapi-chat",
          "model": "gpt-5.5"
        }
      ],
      "prompt": "不要调用工具；只用中文一句话回答：Neko eval 正在验证什么？"
    },
    {
      "id": "sequence-history",
      "mode": "sequence",
      "checks": [
        {
          "kind": "success"
        }
      ],
      "prompts": [
        {
          "id": "turn-1",
          "prompt": "不要调用工具；请记住短语：星轨剪辑。只回复：已记住。"
        },
        {
          "id": "turn-2",
          "prompt": "不要调用工具；上一轮让你记住的短语是什么？只回复这个短语。"
        }
      ]
    },
    {
      "id": "feedback-lite-brief",
      "mode": "feedback-lite",
      "checks": [
        {
          "kind": "judge-pass",
          "rubric": "最终输出应比第一轮更具体，并包含主题、视觉方向和一个可执行下一步。"
        }
      ],
      "initialPrompt": "不要调用工具；生成一个 3 句以内的短动画创意 brief。",
      "maxTurns": 2,
      "goal": "第二轮应该根据第一轮结果让 brief 更具体。"
    }
  ]
}
