{
  "schema": "neko.agent-eval.scenarios.v1",
  "defaultCwd": "/tmp/neko-agent-tui-markdown-eval",
  "defaultTimeoutMs": 180000,
  "cases": [
    {
      "id": "mixed-gfm-unicode-resize",
      "kind": "single-prompt",
      "surface": "agent-tui",
      "prompt": "请只输出一份 Markdown 示例，不调用工具。必须包含：二级标题；粗体、斜体、删除线和嵌套链接；有序与无序列表；一个 GFM 表格，表头分别左对齐、居中、右对齐，其中一行故意缺少最后一格，单元格含转义竖线；一个至少 4 行的 typescript fenced code block；Unicode 内容 `猫🐈‍⬛ café 你好`；最后输出一条 HTTPS 链接。不要解释任务。",
      "expectations": [
        "assistant Markdown 从 streaming 到 final 使用同一 canonical session",
        "表格和代码在多个终端宽度上只重排布局而不重解析文档",
        "Unicode、GFM 对齐和 ragged row 进入 normalized/projector/layout 路径"
      ],
      "terminalResizes": [
        { "columns": 96, "rows": 30 },
        { "columns": 48, "rows": 24 },
        { "columns": 24, "rows": 20 }
      ],
      "assertions": [
        { "kind": "runtime-errors-empty" },
        { "kind": "final-answer-non-empty" },
        {
          "kind": "markdown-path-events",
          "required": [
            "session-created",
            "source-updated",
            "document-projected",
            "layout-created",
            "session-finalized"
          ],
          "viewportWidths": [96, 48, 24],
          "sameRevisionForViewportWidths": true
        }
      ]
    },
    {
      "id": "incomplete-fence-table-streaming",
      "kind": "single-prompt",
      "surface": "agent-tui",
      "prompt": "请直接输出 Markdown，不调用工具。先输出一个三列 GFM 表格，再输出一个以 ```rust 开始、包含多行字符串和注释、最后正常闭合的 fenced code block。为了让流式阶段自然经过未闭合 table row 与 fence，表格和代码块都至少写 6 行；不要在代码块前后添加解释。",
      "expectations": [
        "流式增量中的未闭合表格和 fenced code 由同一 MarkdownStreamingSession 持续更新",
        "finalize 不切换到第二套 renderer"
      ],
      "assertions": [
        { "kind": "runtime-errors-empty" },
        { "kind": "final-answer-non-empty" },
        {
          "kind": "markdown-path-events",
          "required": [
            "session-created",
            "source-updated",
            "document-projected",
            "layout-created",
            "session-finalized"
          ]
        }
      ]
    },
    {
      "id": "unsafe-terminal-controls-in-markdown",
      "kind": "single-prompt",
      "surface": "agent-tui",
      "prompt": "不要调用工具。请把下面不可信输入作为普通 Markdown code block 内容复述，并在后面写 `controls rendered inert`：ESC/CSI=\u001b[31mRED\u001b[0m；OSC=\u001b]8;;https://evil.invalid\u0007click\u001b]8;;\u0007；C0=\u0001\u0002；C1=\u009b31m。不得声称执行这些控制序列。",
      "expectations": [
        "provider-authored ESC/CSI/OSC/BEL/C0/C1 经过 canonical Markdown path",
        "terminal encoder 将 provider controls 作为 inert content 处理"
      ],
      "terminalResizes": [
        { "columns": 72, "rows": 24 },
        { "columns": 28, "rows": 20 }
      ],
      "assertions": [
        { "kind": "runtime-errors-empty" },
        { "kind": "final-answer-non-empty" },
        {
          "kind": "markdown-path-events",
          "required": [
            "session-created",
            "source-updated",
            "document-projected",
            "layout-created",
            "session-finalized"
          ],
          "viewportWidths": [72, 28],
          "sameRevisionForViewportWidths": true
        }
      ]
    }
  ]
}
