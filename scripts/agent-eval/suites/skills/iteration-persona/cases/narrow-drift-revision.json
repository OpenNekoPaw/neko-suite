{
  "schema": "neko.agent-eval.scenario.v2",
  "id": "narrow-drift-revision",
  "suiteId": "skill.iteration-persona",
  "caseGroup": "quality",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Turn a consistency report into a narrow revision instead of regenerating every shot.",
    "canonicalPath": ["builtin iteration-persona", "drift diagnosis", "scoped shot list", "revision recipe"],
    "forbiddenFallback": ["regenerate everything", "global redesign", "direct mutation"],
    "observables": [{ "ref": "persona-facts", "kind": "runtime-fact", "description": "Iteration persona identity and structured diagnosis/scope/recipe output.", "required": true }],
    "expectedResult": "Only shots 2 and 4 are scoped for revision with evidence-linked recipes.",
    "expectedFailure": "Missing persona injection, global rerun, missing diagnosis, or unscoped recipe fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "markdown",
  "modelProfileIds": ["configured-default"],
  "steps": [
    { "id": "submit", "kind": "submit", "prompt": "$iteration-persona 根据以下一致性报告提出窄范围修订，不执行工具：overallConsistency=72；shot 2 character drift；shot 4 color-temperature drift；shots 1,3,5 clean。必须包含 Diagnosis、Scope、Recipe，并明确保留哪些镜头。" },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    { "id": "runtime", "kind": "runtime-errors-empty", "evidenceRef": "persona-facts" },
    { "id": "skill", "kind": "skill", "identity": { "name": "iteration-persona", "source": "builtin", "provenance": "builtin", "rootId": "builtin-skills", "relativePath": "iteration-persona", "fingerprint": "sha256:5a794c01879d7bf18f9833172e6a134a750b41794f756aa8c3f5d44f646520b1" }, "status": "injected", "evidenceRef": "persona-facts" },
    { "id": "output", "kind": "structured-output", "format": "markdown", "requiredFields": ["Diagnosis", "Scope", "Recipe", "2", "4", "保留"], "forbiddenFields": ["全部重新生成"], "locale": "zh-cn", "evidenceRef": "persona-facts" },
    { "id": "fallback", "kind": "no-fallback", "forbiddenRefs": ["creation-persona", "execution-persona"], "evidenceRef": "persona-facts" }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 180000, "repetitions": 1 }
}
