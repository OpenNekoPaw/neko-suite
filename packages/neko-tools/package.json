{
  "name": "neko-tools",
  "displayName": "Neko Tools",
  "description": "Media comparison and diff tools - Image, Video, Audio, Asset variant comparison",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "diff",
    "compare",
    "media",
    "image",
    "video",
    "audio",
    "asset"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neko.mediaDiff",
        "displayName": "Media Diff",
        "selector": [
          {
            "filenamePattern": "*.{png,jpg,jpeg,gif,webp,bmp,svg,mp4,mov,avi,mkv,webm,m4v,mp3,wav,ogg,flac,aac,m4a,jvi}"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "neko.assetVariantDiff",
        "displayName": "Asset Variant Diff",
        "selector": [
          {
            "filenamePattern": "*.asset-diff"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "neko.tools.compareFiles",
        "title": "Compare Files",
        "category": "Neko Tools"
      },
      {
        "command": "neko.tools.compareImages",
        "title": "Compare Images",
        "category": "Neko Tools"
      },
      {
        "command": "neko.tools.compareVideos",
        "title": "Compare Videos",
        "category": "Neko Tools"
      },
      {
        "command": "neko.tools.compareAudio",
        "title": "Compare Audio Files",
        "category": "Neko Tools"
      },
      {
        "command": "neko.tools.compareAssetVariants",
        "title": "Compare Asset Variants",
        "category": "Neko Tools"
      },
      {
        "command": "neko.tools.showMediaInfo",
        "title": "Show Media Info",
        "category": "Neko Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "neko.tools.compareFiles",
          "group": "3_compare@1",
          "when": "listMultiSelection && resourceExtname =~ /\\.(png|jpg|jpeg|gif|webp|bmp|svg|mp4|mov|avi|mkv|webm|m4v|mp3|wav|ogg|flac|aac|m4a)$/i"
        },
        {
          "command": "neko.tools.showMediaInfo",
          "group": "neko@1",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif|webp|bmp|svg|mp4|mov|avi|mkv|webm|m4v|mp3|wav|ogg|flac|aac|m4a)$/i"
        }
      ]
    },
    "configuration": {
      "title": "Neko Tools",
      "properties": {
        "neko.tools.diffMode": {
          "type": "string",
          "enum": ["side-by-side", "overlay", "slider"],
          "default": "side-by-side",
          "description": "Default diff view mode"
        },
        "neko.tools.showMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Show metadata in diff view"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run copy:webview",
    "compile:extension": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:sharp --format=cjs --platform=node",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview/assets && cp ../neko-cut/packages/webview/dist/*.html dist/webview/ 2>/dev/null || true && cp -R ../neko-cut/packages/webview/dist/assets/* dist/webview/assets/ 2>/dev/null || true",
    "watch": "npm run compile:extension -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "sharp": "^0.34.0"
  }
}
