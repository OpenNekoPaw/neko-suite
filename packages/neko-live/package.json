{
  "name": "neko-live",
  "displayName": "Neko Live",
  "description": "Virtual production with camera-driven 3D avatars, motion capture, and AR streaming",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "vtuber",
    "avatar",
    "motion-capture",
    "streaming",
    "mediapipe",
    "vmc"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neko-live",
          "title": "Neko Live",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "neko-live": [
        {
          "type": "webview",
          "id": "neko.livePreview",
          "name": "Live Preview",
          "contextualTitle": "Virtual Production"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.live.start",
        "title": "Start Live Session",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.stop",
        "title": "Stop Live Session",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.selectAvatar",
        "title": "Select Avatar",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.calibrate",
        "title": "Calibrate Tracking",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.startRecording",
        "title": "Start Recording",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.startStreaming",
        "title": "Start Streaming",
        "category": "Neko Live"
      }
    ],
    "configuration": {
      "title": "Neko Live",
      "properties": {
        "neko.live.camera": {
          "type": "string",
          "default": "",
          "description": "Preferred camera device"
        },
        "neko.live.vmcPort": {
          "type": "number",
          "default": 39539,
          "description": "VMC protocol port for external tracking"
        },
        "neko.live.trackingMode": {
          "type": "string",
          "enum": [
            "mediapipe",
            "vmc",
            "hybrid"
          ],
          "default": "vmc",
          "description": "Motion tracking mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview && npm run copy:dist",
    "compile:extension": "cd packages/extension && npm run build",
    "compile:webview": "cd packages/webview && npm run build",
    "copy:dist": "mkdir -p dist/extension dist/webview && cp packages/extension/dist/extension.js dist/extension/ && cp -r packages/webview/dist/* dist/webview/",
    "watch": "cd packages/extension && npm run watch",
    "lint": "eslint packages --ext ts,tsx",
    "test": "vitest --passWithNoTests",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
