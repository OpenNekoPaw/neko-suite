{
  "name": "neko-live",
  "displayName": "%neko.live.displayName%",
  "description": "%neko.live.description%",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "vtuber",
    "avatar",
    "motion-capture",
    "streaming",
    "mediapipe",
    "vmc"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neko-live",
          "title": "%neko.live.viewContainer.title%",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "neko-live": [
        {
          "type": "webview",
          "id": "neko.livePreview",
          "name": "%neko.live.view.name%",
          "contextualTitle": "%neko.live.view.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.live.start",
        "title": "%neko.live.cmd.start%",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.stop",
        "title": "%neko.live.cmd.stop%",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.selectAvatar",
        "title": "%neko.live.cmd.selectAvatar%",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.calibrate",
        "title": "%neko.live.cmd.calibrate%",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.startRecording",
        "title": "%neko.live.cmd.startRecording%",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.startStreaming",
        "title": "%neko.live.cmd.startStreaming%",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.useDevice",
        "title": "%neko.live.cmd.useDevice%",
        "category": "Neko Live"
      },
      {
        "command": "neko.tracking.start",
        "title": "%neko.tracking.cmd.start%",
        "category": "Neko Tracking"
      },
      {
        "command": "neko.tracking.stop",
        "title": "%neko.tracking.cmd.stop%",
        "category": "Neko Tracking"
      },
      {
        "command": "neko.tracking.status",
        "title": "%neko.tracking.cmd.status%",
        "category": "Neko Tracking"
      }
    ],
    "configuration": {
      "title": "%neko.live.config.title%",
      "properties": {
        "neko.live.camera": {
          "type": "string",
          "default": "",
          "description": "%neko.live.config.camera%"
        },
        "neko.live.vmcPort": {
          "type": "number",
          "default": 39539,
          "description": "%neko.live.config.vmcPort%"
        },
        "neko.live.trackingMode": {
          "type": "string",
          "enum": [
            "mediapipe",
            "vmc",
            "hybrid"
          ],
          "default": "vmc",
          "description": "%neko.live.config.trackingMode%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run compile:extension && pnpm run compile:webview && pnpm run copy:dist",
    "compile:extension": "cd packages/extension && pnpm run build",
    "compile:webview": "cd packages/webview && pnpm run build",
    "copy:dist": "mkdir -p dist/extension dist/webview && cp packages/extension/dist/extension.js dist/extension/ && cp -r packages/webview/dist/* dist/webview/",
    "watch": "cd packages/extension && pnpm run watch",
    "lint": "eslint packages --ext ts,tsx",
    "test": "vitest",
    "package": "pnpm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  }
}
