{
  "name": "neko-live",
  "displayName": "Neko Live",
  "description": "Virtual production with camera-driven 3D avatars, motion capture, and AR streaming",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "vtuber",
    "avatar",
    "motion-capture",
    "streaming",
    "mediapipe",
    "vmc"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "neko-live",
          "title": "Neko Live",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "neko-live": [
        {
          "type": "webview",
          "id": "neko.livePreview",
          "name": "Live Preview",
          "contextualTitle": "Virtual Production"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.live.start",
        "title": "Start Live Session",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.stop",
        "title": "Stop Live Session",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.selectAvatar",
        "title": "Select Avatar",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.calibrate",
        "title": "Calibrate Tracking",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.startRecording",
        "title": "Start Recording",
        "category": "Neko Live"
      },
      {
        "command": "neko.live.startStreaming",
        "title": "Start Streaming",
        "category": "Neko Live"
      }
    ],
    "configuration": {
      "title": "Neko Live",
      "properties": {
        "neko.live.camera": {
          "type": "string",
          "default": "",
          "description": "Preferred camera device"
        },
        "neko.live.vmcPort": {
          "type": "number",
          "default": 39539,
          "description": "VMC protocol port for external tracking"
        },
        "neko.live.trackingMode": {
          "type": "string",
          "enum": ["mediapipe", "vmc", "hybrid"],
          "default": "mediapipe",
          "description": "Motion tracking mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
