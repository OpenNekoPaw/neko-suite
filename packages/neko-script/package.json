{
  "name": "neko-script",
  "displayName": "Neko Script",
  "description": "AI instruction protocol and automation scripting language for Neko Suite",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "script",
    "automation",
    "ai",
    "protocol",
    "dsl"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:nekoscript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nekoscript",
        "aliases": ["Neko Script", "nekoscript"],
        "extensions": [".nksc", ".nekoscript"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nekoscript",
        "scopeName": "source.nekoscript",
        "path": "./syntaxes/nekoscript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "neko.script.run",
        "title": "Run Script",
        "category": "Neko Script"
      },
      {
        "command": "neko.script.validate",
        "title": "Validate Script",
        "category": "Neko Script"
      },
      {
        "command": "neko.script.fromTimeline",
        "title": "Generate Script from Timeline",
        "category": "Neko Script"
      },
      {
        "command": "neko.script.toTimeline",
        "title": "Apply Script to Timeline",
        "category": "Neko Script"
      }
    ],
    "configuration": {
      "title": "Neko Script",
      "properties": {
        "neko.script.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically validate scripts on save"
        },
        "neko.script.executeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Execute script automatically on save"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
