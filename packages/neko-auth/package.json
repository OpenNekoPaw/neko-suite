{
  "name": "neko-auth",
  "displayName": "Neko Auth",
  "description": "Unified authentication for Neko Suite — OAuth 2.0 + PKCE SSO",
  "version": "0.1.0",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "auth",
    "sso",
    "oauth",
    "neko"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "%neko.auth.config.title%",
      "properties": {
        "neko.auth.clientId": {
          "type": "string",
          "default": "",
          "description": "%neko.auth.clientId.description%"
        },
        "neko.auth.authUrl": {
          "type": "string",
          "default": "",
          "description": "%neko.auth.authUrl.description%"
        },
        "neko.auth.tokenUrl": {
          "type": "string",
          "default": "",
          "description": "%neko.auth.tokenUrl.description%"
        },
        "neko.auth.aiCatalogUrl": {
          "type": "string",
          "default": "",
          "description": "%neko.auth.aiCatalogUrl.description%"
        },
        "neko.auth.scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "openid",
            "profile",
            "email"
          ],
          "description": "%neko.auth.scopes.description%"
        },
        "neko.auth.redirectPort": {
          "type": "number",
          "default": 6419,
          "description": "%neko.auth.redirectPort.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "esbuild ./packages/extension/src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild ./packages/extension/src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@neko/auth-core": "workspace:*",
    "@neko/auth-extension": "workspace:*",
    "@neko/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.2"
  }
}
