{
  "name": "neko-desktop",
  "displayName": "Neko Desktop",
  "description": "Standalone desktop AppHost for the Neko Suite AIGC editor workbench",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main/index.cjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "dev:renderer": "vite --host 127.0.0.1",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@neko-canvas/webview": "workspace:*",
    "@neko-agent/webview": "workspace:*",
    "@neko-audio/webview": "workspace:*",
    "@neko-model/webview": "workspace:*",
    "@neko/host": "workspace:*",
    "@neko/neko-client": "workspace:*",
    "@neko-sketch/webview": "workspace:*",
    "@neko/preview-webview": "workspace:*",
    "@neko/webview": "workspace:*",
    "@neko/shared": "workspace:*",
    "@neko/ui": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.3.3",
    "esbuild": "^0.20.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "jsdom": "^27.0.1",
    "typescript": "^5.3.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  }
}
