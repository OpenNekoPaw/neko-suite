{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@neko-agent/webview/root": ["src/renderer/webview-root-types.tsx"],
      "@neko-agent/webview/workbench-surfaces": [
        "../neko-agent/packages/webview/src/workbench-surfaces.ts"
      ],
      "@neko-audio/webview/workbench-adapter": [
        "../neko-audio/packages/webview/src/workbench-adapter.ts"
      ],
      "@neko-canvas/webview/workbench-adapter": [
        "../neko-canvas/packages/webview/src/workbench-adapter.ts"
      ],
      "@neko-model/webview/workbench-adapter": [
        "../neko-model/packages/webview/src/workbench-adapter.ts"
      ],
      "@neko-sketch/webview/workbench-adapter": [
        "../neko-sketch/packages/webview/src/workbench-adapter.ts"
      ],
      "@neko/preview-webview/workbench-adapter": [
        "../neko-preview/packages/webview/src/workbench-adapter.ts"
      ],
      "@neko/webview/workbench-adapter": [
        "../neko-cut/packages/webview/src/workbench-adapter.ts"
      ],
      "@neko/webview/root": ["src/renderer/webview-root-types.tsx"],
      "@/*": ["../neko-agent/packages/webview/src/*"],
      "@neko-agent/types": ["../neko-agent/packages/agent-types/src/index.ts"],
      "@neko-agent/types/*": ["../neko-agent/packages/agent-types/src/*"],
      "@neko/markdown": ["../neko-markdown/src/index.ts"],
      "@neko/markdown/*": ["../neko-markdown/src/*"],
      "@neko/workbench-core": ["../neko-workbench-core/src/index.ts"],
      "@neko/workbench-core/*": ["../neko-workbench-core/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts"]
}
