{
  "name": "@neko/cli",
  "version": "0.0.1",
  "description": "CLI for Neko AI Agent - Professional TUI with streaming, markdown, and rich interactions",
  "type": "module",
  "bin": {
    "nekoagent": "./dist/cli.js",
    "neko": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsup",
    "build:exe": "sh scripts/build-exe.sh",
    "build:bundle": "esbuild src/cli.tsx --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.bundle.js --minify --external:fsevents --external:ink --external:react --external:yoga-wasm-web",
    "dev": "tsx src/cli.tsx",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest --run --passWithNoTests"
  },
  "pkg": {
    "assets": [],
    "outputPath": "dist"
  },
  "dependencies": {
    "@neko/agent": "workspace:*",
    "@neko/platform": "workspace:*",
    "@neko/shared": "workspace:*",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "zustand": "^5.0.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.20.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "license": "MIT"
}
