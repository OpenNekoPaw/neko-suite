{
  "name": "@neko/cli",
  "version": "0.0.1",
  "description": "Terminal TUI and developer utilities for Neko AI Agent",
  "type": "module",
  "bin": {
    "nekoagent": "./dist/cli.js",
    "neko": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsup",
    "build:exe": "sh scripts/build-exe.sh",
    "build:bundle": "esbuild src/cli.tsx --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.bundle.js --minify --external:fsevents --external:ink --external:react --external:yoga-wasm-web",
    "dev": "tsx src/cli.tsx",
    "test": "vitest --root ../.. packages/cli-tui/src",
    "test:run": "vitest --root ../.. --run packages/cli-tui/src"
  },
  "pkg": {
    "assets": [],
    "outputPath": "dist"
  },
  "dependencies": {
    "@neko-agent/types": "workspace:*",
    "@neko/agent": "workspace:*",
    "@neko/ai-sdk": "workspace:*",
    "@neko/asset": "workspace:*",
    "@neko/content": "workspace:*",
    "@neko/entity": "workspace:*",
    "@neko/host": "workspace:*",
    "@neko/markdown": "workspace:*",
    "@neko/market-core": "workspace:*",
    "@neko/platform": "workspace:*",
    "@neko/search": "workspace:*",
    "@neko/shared": "workspace:*",
    "@neko/skills": "workspace:*",
    "adm-zip": "^0.5.16",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "epub2": "^3.0.2",
    "ink": "^5.0.1",
    "lowlight": "^3.3.0",
    "neko-assets": "workspace:*",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "unicode-segmenter": "^0.17.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.20.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "license": "AGPL-3.0-or-later"
}
