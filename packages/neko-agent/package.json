{
  "name": "neko-agent",
  "displayName": "NekoAgent",
  "description": "AI Agent for creative workflows in VSCode",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agent",
    "llm",
    "assistant",
    "mcp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools",
    "neko.neko-preview"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "neko-assistant",
          "title": "Neko AI",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "neko-assistant": [
        {
          "type": "webview",
          "id": "neko.aiAssistant",
          "name": "%neko.aiAssistant.name%",
          "contextualTitle": "%neko.aiAssistant.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.ai.chat",
        "title": "%neko.ai.chat.title%",
        "category": "NekoAgent"
      },
      {
        "command": "neko.ai.generateImage",
        "title": "Generate Image",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateVideo",
        "title": "Generate Video",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateTTS",
        "title": "Generate TTS",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateMusic",
        "title": "Generate Music",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateCharacter",
        "title": "Generate Character",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.transferStyle",
        "title": "Transfer Style",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.enhanceVideo",
        "title": "Enhance Video",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.optimizeAudio",
        "title": "Optimize Audio",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.analyzeImage",
        "title": "Analyze Image",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.extractImageText",
        "title": "Extract Image Text (OCR)",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.analyzeVideo",
        "title": "Analyze Video",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.extractVideoSummary",
        "title": "Extract Video Summary",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateScript",
        "title": "Generate Script",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.optimizeScript",
        "title": "Optimize Script",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateStoryboard",
        "title": "Generate Storyboard",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.generateSubtitles",
        "title": "Generate Subtitles",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.script.generate",
        "title": "%neko.script.generate.title%",
        "category": "NekoAgent: Script"
      },
      {
        "command": "neko.script.optimize",
        "title": "%neko.script.optimize.title%",
        "category": "NekoAgent: Script"
      },
      {
        "command": "neko.script.generateImage",
        "title": "%neko.script.generateImage.title%",
        "category": "NekoAgent: Script"
      },
      {
        "command": "neko.script.generateVideo",
        "title": "%neko.script.generateVideo.title%",
        "category": "NekoAgent: Script"
      },
      {
        "command": "neko.ai.summarizeDocument",
        "title": "%neko.ai.summarizeDocument.title%",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.ai.chatWithDocument",
        "title": "%neko.ai.chatWithDocument.title%",
        "category": "NekoAgent: AI"
      },
      {
        "command": "neko.pipeline.start",
        "title": "Start Creative Pipeline...",
        "category": "NekoAgent: Pipeline"
      },
      {
        "command": "neko.pipeline.startFromFile",
        "title": "Create Video from This File",
        "category": "NekoAgent: Pipeline"
      },
      {
        "command": "neko.pipeline.retryFailed",
        "title": "Retry Failed Pipeline Scenes",
        "category": "NekoAgent: Pipeline"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "neko.script.generate",
          "group": "neko@1",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.script.optimize",
          "group": "neko@2",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.script.generateImage",
          "group": "neko@3",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.script.generateVideo",
          "group": "neko@4",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.pipeline.startFromFile",
          "group": "neko@5",
          "when": "editorLangId =~ /markdown|plaintext|txt|nekostory/"
        }
      ],
      "explorer/context": [
        {
          "command": "neko.ai.summarizeDocument",
          "group": "neko@1",
          "when": "resourceExtname =~ /\\.pdf|\\.docx|\\.doc|\\.epub|\\.pptx|\\.ppt|\\.xlsx|\\.xls|\\.fdx|\\.txt|\\.md|\\.fountain/"
        },
        {
          "command": "neko.ai.chatWithDocument",
          "group": "neko@2",
          "when": "resourceExtname =~ /\\.pdf|\\.docx|\\.doc|\\.epub|\\.pptx|\\.ppt|\\.xlsx|\\.xls|\\.fdx|\\.txt|\\.md|\\.fountain/"
        },
        {
          "command": "neko.pipeline.startFromFile",
          "group": "neko@3",
          "when": "resourceExtname =~ /\\.fountain|\\.md|\\.txt|\\.pdf|\\.docx/"
        },
        {
          "command": "neko.ai.analyzeImage",
          "group": "neko@4",
          "when": "resourceExtname =~ /\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.bmp/"
        },
        {
          "command": "neko.ai.extractImageText",
          "group": "neko@5",
          "when": "resourceExtname =~ /\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.bmp/"
        },
        {
          "command": "neko.ai.analyzeVideo",
          "group": "neko@6",
          "when": "resourceExtname =~ /\\.mp4|\\.mov|\\.mkv|\\.avi|\\.webm|\\.m4v/"
        },
        {
          "command": "neko.ai.generateSubtitles",
          "group": "neko@7",
          "when": "resourceExtname =~ /\\.mp4|\\.mov|\\.mkv|\\.avi|\\.webm|\\.m4v/"
        }
      ]
    },
    "configuration": {
      "title": "NekoAgent",
      "properties": {
        "neko.agent.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "google",
            "azure",
            "ollama"
          ],
          "default": "anthropic",
          "description": "Default AI provider"
        },
        "neko.agent.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "Default model to use"
        },
        "neko.agent.apiKey.anthropic": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key"
        },
        "neko.agent.apiKey.openai": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key"
        },
        "neko.agent.media.outputDir": {
          "type": "string",
          "default": "",
          "description": "Directory to save generated media. Defaults to <workspace>/.neko/generated"
        },
        "neko.agent.media.showSaveNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when generated media is saved to disk"
        },
        "neko.agent.mcp.servers": {
          "type": "array",
          "default": [],
          "description": "MCP server configurations",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Server name"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ],
                "description": "Transport type"
              },
              "command": {
                "type": "string",
                "description": "Command to run (for stdio)"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command arguments"
              },
              "url": {
                "type": "string",
                "description": "Server URL (for http)"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether the server is enabled"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "esbuild ./packages/extension/src/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile:webview": "cd packages/webview && npm run build && cd ../.. && npm run copy:webview",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview && cp -r packages/webview/dist/* dist/webview/",
    "watch": "npm run compile:extension -- --watch",
    "lint": "eslint packages --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/agent": "workspace:*",
    "@neko/platform": "workspace:*",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "typescript": "^5.3.2",
    "vitest": "^4.0.18"
  }
}
