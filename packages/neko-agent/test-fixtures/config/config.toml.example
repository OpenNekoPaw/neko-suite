# Copy to ~/.neko/config.toml or another user-owned config.toml path for explicit real API harness runs.
# Do not commit real credentials. Use environment placeholders where possible.

default_provider = "service-gateway"
default_model = "service-chat"

[default_models.llm]
provider_id = "service-gateway"
model_id = "service-chat"

[[providers]]
id = "service-gateway"
name = "Service Gateway"
type = "newapi"
api_url = "https://api.example.invalid/v1"
api_key = "${NEKO_AGENT_SERVICE_API_KEY}"
enabled = true
connection_kind = "gateway"
protocol_profile = "newapi"
requires_api_key = true

[[models]]
id = "service-chat"
name = "service-chat"
provider_id = "service-gateway"
type = "llm"
capabilities = ["chat", "streaming", "function_calling"]
enabled = true
