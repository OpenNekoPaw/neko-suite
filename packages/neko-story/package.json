{
  "name": "neko-story",
  "displayName": "Neko Story",
  "description": "Script-driven filmmaking with LSP support for story files",
  "version": "0.0.1",
  "private": true,
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "story",
    "script",
    "screenplay",
    "lsp",
    "filmmaking"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nekostory",
        "aliases": ["Neko Story", "nekostory"],
        "extensions": [".nks", ".story", ".fountain"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nekostory",
        "scopeName": "source.nekostory",
        "path": "./syntaxes/nekostory.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "neko.story.preview",
        "title": "Preview Story",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.toTimeline",
        "title": "Convert to Timeline",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.generateStoryboard",
        "title": "Generate Storyboard",
        "category": "Neko Story"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm run build:webview && pnpm run build:extension",
    "build:extension": "pnpm --filter @neko-story/extension run build",
    "build:webview": "pnpm --filter @neko-story/webview run build",
    "watch": "pnpm --filter @neko-story/extension run watch",
    "lint": "pnpm --filter @neko-story/extension run lint",
    "test": "pnpm --filter @neko-story/extension run test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
