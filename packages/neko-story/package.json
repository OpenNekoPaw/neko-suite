{
  "name": "neko-story",
  "displayName": "Neko Story",
  "description": "Script-driven filmmaking with LSP support for story files",
  "version": "0.0.1",
  "private": true,
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "story",
    "script",
    "screenplay",
    "lsp",
    "filmmaking"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nekostory",
        "aliases": [
          "Neko Story",
          "nekostory"
        ],
        "extensions": [
          ".fountain",
          ".nks",
          ".story"
        ],
        "icon": {
          "light": "./icons/file-story.svg",
          "dark": "./icons/file-story.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nekostory",
        "scopeName": "source.nekostory",
        "path": "./syntaxes/nekostory.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "neko.story.preview",
        "title": "%neko.story.preview.title%",
        "icon": "$(open-preview)",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.toTimeline",
        "title": "%neko.story.toTimeline.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.generateStoryboard",
        "title": "%neko.story.generateStoryboard.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.startVideoCreation",
        "title": "%neko.story.startVideoCreation.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.newFile",
        "title": "%neko.story.newFile.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.openCharacterRegistry",
        "title": "%neko.story.openCharacterRegistry.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.sendToAgent",
        "title": "%neko.story.sendToAgent.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.applyInlineDiff",
        "title": "%neko.story.applyInlineDiff.title%",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.scriptTableView",
        "title": "%neko.story.scriptTableView.title%",
        "icon": "$(table)",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.showCreativeEntityDetail",
        "title": "%neko.story.showCreativeEntityDetail.title%",
        "icon": "$(account)",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.setCreativeEntityDefaultBinding",
        "title": "%neko.story.setCreativeEntityDefaultBinding.title%",
        "icon": "$(link)",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.reviewVisualDrafts",
        "title": "%neko.story.reviewVisualDrafts.title%",
        "icon": "$(sparkle)",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.showMissingMaterialQueue",
        "title": "%neko.story.showMissingMaterialQueue.title%",
        "icon": "$(warning)",
        "category": "Neko Story"
      },
      {
        "command": "neko.story.showRepresentationPackageDetail",
        "title": "%neko.story.showRepresentationPackageDetail.title%",
        "icon": "$(symbol-structure)",
        "category": "Neko Story"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "neko.story.preview",
          "when": "editorLangId == nekostory",
          "group": "navigation"
        },
        {
          "command": "neko.story.scriptTableView",
          "when": "editorLangId == nekostory",
          "group": "navigation"
        },
        {
          "command": "neko.story.startVideoCreation",
          "when": "editorLangId == nekostory",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "neko.story.sendToAgent",
          "when": "editorLangId == nekostory",
          "group": "neko@1"
        },
        {
          "command": "neko.story.startVideoCreation",
          "when": "editorLangId == nekostory",
          "group": "neko@2"
        }
      ],
      "explorer/context": [],
      "neko.explorer.newProject": [
        {
          "command": "neko.story.newFile",
          "group": "1@6"
        },
        {
          "command": "neko.story.openCharacterRegistry",
          "group": "1@7"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run build:types && pnpm run build:parser && pnpm run build:webview && pnpm run build:extension",
    "build": "pnpm run compile",
    "build:types": "pnpm --filter @neko-story/types run build",
    "build:parser": "pnpm --filter @neko-story/parser run build",
    "build:extension": "pnpm --filter @neko-story/extension run build",
    "build:webview": "pnpm --filter @neko-story/webview run build",
    "watch": "pnpm --filter @neko-story/extension run watch",
    "lint": "pnpm --filter @neko-story/extension run lint",
    "test": "sh -c 'echo \"Delegated to Turbo dependsOn. Run pnpm run test:packages for manual aggregation.\"' --",
    "test:packages": "pnpm turbo run test --filter=@neko-story/parser --filter=@neko-story/extension --filter=@neko-story/webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  }
}
