{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "../../dist",
    "rootDir": "./src",
    "paths": {
      "@neko-story/headless": ["../headless/src/index.ts"],
      "@neko-story/headless/*": ["../headless/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../headless" },
    { "path": "../types" },
    { "path": "../parser" }
  ]
}
