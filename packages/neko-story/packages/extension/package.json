{
  "name": "@neko-story/extension",
  "version": "0.0.1",
  "private": true,
  "description": "Neko Story VSCode extension core",
  "main": "../../dist/extension.js",
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=../../dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "pnpm run build -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest"
  },
  "dependencies": {
    "@neko/entity": "workspace:*",
    "@neko/shared": "workspace:*",
    "@neko-story/headless": "workspace:*",
    "@neko-story/parser": "workspace:*",
    "@neko-story/types": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "license": "AGPL-3.0-or-later"
}
