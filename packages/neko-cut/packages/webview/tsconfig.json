{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@neko/shared": ["../shared/src/index.ts"],
      "@neko/shared/*": ["../shared/src/*"],
      "@neko/effects-runtime": ["../effects-runtime/src/index.ts"],
      "@neko/effects-runtime/*": ["../effects-runtime/src/*"]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
