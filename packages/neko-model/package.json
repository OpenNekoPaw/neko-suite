{
  "name": "neko-model",
  "displayName": "NekoModel",
  "description": "3D Model Editor for VSCode",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "3d",
    "model",
    "gltf",
    "animation"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools",
    "neko.neko-preview"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neko.modelEditor",
        "displayName": "3D Model Editor",
        "selector": [
          {
            "filenamePattern": "*.gltf"
          },
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.vrm"
          },
          {
            "filenamePattern": "*.nkm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "neko.model.new",
        "title": "%neko.model.new.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.importAsset",
        "title": "%neko.model.importAsset.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.deleteSelected",
        "title": "%neko.model.deleteSelected.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.escape",
        "title": "%neko.model.escape.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.selectAll",
        "title": "%neko.model.selectAll.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.undo",
        "title": "%neko.model.undo.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.redo",
        "title": "%neko.model.redo.title%",
        "category": "NekoModel"
      },
      {
        "command": "neko.model.resetView",
        "title": "%neko.model.resetView.title%",
        "category": "NekoModel"
      }
    ],
    "menus": {
      "neko.explorer.newProject": [
        {
          "command": "neko.model.new",
          "group": "1@7"
        }
      ]
    },
    "keybindings": [
      {
        "command": "neko.model.deleteSelected",
        "key": "delete",
        "when": "activeCustomEditorId == 'neko.modelEditor'"
      },
      {
        "command": "neko.model.deleteSelected",
        "key": "backspace",
        "when": "activeCustomEditorId == 'neko.modelEditor'"
      },
      {
        "command": "neko.model.escape",
        "key": "escape",
        "when": "activeCustomEditorId == 'neko.modelEditor'"
      },
      {
        "command": "neko.model.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "activeCustomEditorId == 'neko.modelEditor'"
      },
      {
        "command": "neko.model.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'neko.modelEditor'"
      },
      {
        "command": "neko.model.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'neko.modelEditor'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run compile:extension && pnpm run compile:webview && pnpm run copy:extension && pnpm run copy:webview",
    "compile:extension": "cd packages/extension && pnpm run build",
    "compile:webview": "cd packages/webview && pnpm run build",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview/assets && cp packages/webview/dist/*.html dist/webview/ 2>/dev/null || true && cp -R packages/webview/dist/assets/* dist/webview/assets/ 2>/dev/null || true",
    "copy:extension": "mkdir -p dist && cp packages/extension/dist/extension.js dist/extension.js",
    "watch": "pnpm run compile:extension -- --watch",
    "lint": "eslint packages --ext ts,tsx",
    "test": "vitest run --passWithNoTests",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.2"
  }
}
