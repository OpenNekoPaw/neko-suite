{
  "name": "neko-sketch",
  "displayName": "Neko Sketch",
  "description": "Krita-level drawing tools with pressure sensitivity for canvas enhancement",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "drawing",
    "sketch",
    "brush",
    "painting",
    "pressure"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-canvas"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neko.sketch.enable",
        "title": "Enable Sketch Mode",
        "category": "Neko Sketch"
      },
      {
        "command": "neko.sketch.selectBrush",
        "title": "Select Brush",
        "category": "Neko Sketch"
      },
      {
        "command": "neko.sketch.adjustSize",
        "title": "Adjust Brush Size",
        "category": "Neko Sketch"
      },
      {
        "command": "neko.sketch.pickColor",
        "title": "Pick Color",
        "category": "Neko Sketch"
      }
    ],
    "configuration": {
      "title": "Neko Sketch",
      "properties": {
        "neko.sketch.pressureSensitivity": {
          "type": "boolean",
          "default": true,
          "description": "Enable pressure sensitivity for drawing tablets"
        },
        "neko.sketch.defaultBrush": {
          "type": "string",
          "enum": ["pencil", "pen", "brush", "airbrush", "eraser"],
          "default": "brush",
          "description": "Default brush type"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
