{
  "name": "neko-sketch",
  "displayName": "Neko Sketch",
  "description": "Professional 2D drawing and painting tools with pressure sensitivity",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "drawing",
    "sketch",
    "brush",
    "painting",
    "pressure",
    "2d"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neko.sketchEditor",
        "displayName": "%neko.sketch.editor.title%",
        "selector": [
          {
            "filenamePattern": "*.nks"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "neko.sketchLayerOutline",
          "name": "%neko.sketch.layerOutline.title%",
          "when": "activeCustomEditorId == 'neko.sketchEditor'",
          "icon": "$(layers)"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.sketch.new",
        "title": "%neko.sketch.new.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectBrush",
        "title": "%neko.sketch.selectBrush.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.adjustSize",
        "title": "%neko.sketch.adjustSize.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.pickColor",
        "title": "%neko.sketch.pickColor.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.deleteSelected",
        "title": "%neko.sketch.deleteSelected.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.escape",
        "title": "%neko.sketch.escape.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectAll",
        "title": "%neko.sketch.selectAll.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.undo",
        "title": "%neko.sketch.undo.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.redo",
        "title": "%neko.sketch.redo.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.import",
        "title": "%neko.sketch.import.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.authoring.importImageSource",
        "title": "%neko.sketch.authoring.importImageSource.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.export",
        "title": "%neko.sketch.export.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectLayerFromOutline",
        "title": "%neko.sketch.selectLayerFromOutline.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.resetZoom",
        "title": "%neko.sketch.resetZoom.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.rotateViewLeft",
        "title": "%neko.sketch.rotateViewLeft.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.rotateViewRight",
        "title": "%neko.sketch.rotateViewRight.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.resetRotation",
        "title": "%neko.sketch.resetRotation.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.sendToTimeline",
        "title": "%neko.sketch.sendToTimeline.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.sendToCanvas",
        "title": "%neko.sketch.sendToCanvas.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.editImage",
        "title": "%neko.sketch.editImage.title%",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectEraser",
        "title": "Select Eraser",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectMove",
        "title": "Select Move Tool",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectShape",
        "title": "Select Shape Tool",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectZoom",
        "title": "Select Zoom Tool",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectFill",
        "title": "Select Fill Tool",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectSelect",
        "title": "Select Selection Tool",
        "category": "NekoSketch"
      },
      {
        "command": "neko.sketch.selectTransform",
        "title": "Select Transform Tool",
        "category": "NekoSketch"
      }
    ],
    "menus": {
      "explorer/context": [],
      "neko.explorer.newProject": [
        {
          "command": "neko.sketch.new",
          "group": "1@4"
        }
      ]
    },
    "configuration": {
      "title": "%neko.sketch.config.title%",
      "properties": {
        "neko.sketch.pressureSensitivity": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.pressureSensitivity%"
        },
        "neko.sketch.psdImport.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%neko.sketch.config.psdImportEnabled%"
        },
        "neko.sketch.aiOps.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%neko.sketch.config.aiOpsEnabled%"
        },
        "neko.sketch.aiOps.generate.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsGenerateEnabled%"
        },
        "neko.sketch.aiOps.inpaint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsInpaintEnabled%"
        },
        "neko.sketch.aiOps.styleTransfer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsStyleTransferEnabled%"
        },
        "neko.sketch.aiOps.upscale.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsUpscaleEnabled%"
        },
        "neko.sketch.aiOps.autoLayer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsAutoLayerEnabled%"
        },
        "neko.sketch.aiOps.lineartColorize.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsLineartColorizeEnabled%"
        },
        "neko.sketch.aiOps.smartSelection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%neko.sketch.config.aiOpsSmartSelectionEnabled%"
        },
        "neko.sketch.defaultBrush": {
          "type": "string",
          "enum": [
            "pencil",
            "pen",
            "watercolor",
            "airbrush",
            "eraser",
            "marker",
            "pixel"
          ],
          "default": "pen",
          "description": "%neko.sketch.config.defaultBrush%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run compile:extension && pnpm run compile:webview && pnpm run copy:extension && pnpm run copy:webview",
    "compile:extension": "cd packages/extension && pnpm run build",
    "compile:webview": "cd packages/webview && pnpm run build",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview/assets && cp packages/webview/dist/*.html dist/webview/ 2>/dev/null || true && cp -R packages/webview/dist/assets/* dist/webview/assets/ 2>/dev/null || true",
    "copy:extension": "mkdir -p dist && cp packages/extension/dist/extension.js dist/extension.js",
    "watch": "pnpm run compile:extension -- --watch",
    "lint": "eslint packages --ext ts,tsx",
    "test": "pnpm exec vitest --dir packages/extension --passWithNoTests",
    "test:packages": "pnpm turbo run test --filter=@neko-sketch/webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  }
}
