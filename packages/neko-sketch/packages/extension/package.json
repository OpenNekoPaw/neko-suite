{
  "name": "@neko-sketch/extension",
  "private": true,
  "version": "0.0.1",
  "description": "NekoSketch VS Code extension host",
  "main": "./dist/extension.js",
  "types": "./src/extension.ts",
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "analyze:bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --metafile=dist/extension.meta.json --analyze",
    "watch": "pnpm run build -- --watch",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@neko/shared": "workspace:*",
    "ag-psd": "^28.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  },
  "license": "AGPL-3.0-or-later"
}
