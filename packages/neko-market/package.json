{
  "name": "neko-market",
  "displayName": "Neko Marketplace",
  "description": "Unified marketplace for Neko Suite — skills, shaders, models, presets",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["marketplace", "skills", "assets", "neko"],
  "extensionKind": ["workspace"],
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neko-marketplace",
          "title": "%neko.marketplace.title%",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "neko-marketplace": [
        {
          "type": "webview",
          "id": "neko.marketplace",
          "name": "%neko.marketplace.name%"
        }
      ]
    },
    "configuration": {
      "title": "Neko Marketplace",
      "properties": {
        "neko.market.registryUrl": {
          "type": "string",
          "default": "",
          "description": "Custom marketplace registry URL. Leave empty to use the official registry (https://market.neko.dev/api/v1)."
        }
      }
    },
    "commands": [
      {
        "command": "neko.market.open",
        "title": "%neko.market.open.title%",
        "category": "Neko Market"
      },
      {
        "command": "neko.market.openSkills",
        "title": "%neko.market.openSkills.title%",
        "category": "Neko Market"
      },
      {
        "command": "neko.market.checkout",
        "title": "Checkout",
        "category": "Neko Market"
      },
      {
        "command": "neko.market.renew",
        "title": "Renew",
        "category": "Neko Market"
      },
      {
        "command": "neko.market.invoice",
        "title": "Open Invoice",
        "category": "Neko Market"
      },
      {
        "command": "neko.market.support",
        "title": "Open Support",
        "category": "Neko Market"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run compile:extension && pnpm run compile:webview",
    "compile:extension": "esbuild ./packages/extension/src/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "compile:webview": "cd packages/webview && pnpm run build && cd ../.. && pnpm run copy:webview",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview && cp -r packages/webview/dist/* dist/webview/",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2"
  }
}
