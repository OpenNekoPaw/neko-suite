{
  "name": "neko-engine",
  "displayName": "Neko Engine",
  "description": "Sidecar process for heavy computation - FFmpeg encoding, media processing",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "video",
    "engine",
    "media",
    "ffmpeg",
    "processing"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neko.engine.start",
        "title": "%neko.engine.start.title%",
        "category": "Neko Engine"
      },
      {
        "command": "neko.engine.stop",
        "title": "%neko.engine.stop.title%",
        "category": "Neko Engine"
      },
      {
        "command": "neko.engine.status",
        "title": "%neko.engine.status.title%",
        "category": "Neko Engine"
      },
      {
        "command": "neko.engine.openDocs",
        "title": "Open API Documentation",
        "category": "Neko Engine"
      }
    ],
    "configuration": {
      "title": "Neko Engine",
      "properties": {
        "neko.engine.hwAccel": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "videotoolbox", "nvenc", "vaapi", "qsv", "none"],
          "description": "Hardware acceleration mode for encoding/decoding"
        },
        "neko.engine.gpuDevice": {
          "type": "string",
          "default": "",
          "description": "Preferred GPU device name (empty for auto-select)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./packages/extension/src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "lint": "eslint packages/extension/src --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@neko-engine/native-napi": "workspace:*"
  }
}
