.vscode/**
.vscode-test/**
src/**
node_modules/**
scripts/**
*.ts
!dist/**
.gitignore
tsconfig.json
*.md

# Build tools
.turbo/**
Cargo.lock
Cargo.toml
.cargo/**

# Rust build artifacts — not needed in VSIX
target/**

# Sub-packages — exclude all, then re-include runtime files
packages/**
!packages/native-napi/index.js
!packages/native-napi/index.d.ts
!packages/native-napi/neko-engine.*.node

# FFmpeg dylibs (copied to native-napi dir by bundle-ffmpeg.js)
!packages/native-napi/*.dylib
!packages/native-napi/*.so*
!packages/native-napi/*.dll

# ORT dylibs for ML inference
!bin/**
