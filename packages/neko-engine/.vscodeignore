# Source code
src/**
scripts/**

# Config & tooling
.vscode/**
.vscode-test/**
.turbo/**
.gitignore
tsconfig.json
tsconfig.*.json
eslint.config.*
vitest.config.*
*.md

# TypeScript source
*.ts
!*.d.ts

# Test & coverage artifacts
**/*.test.ts
**/*.spec.ts
**/__tests__/**
coverage/**

# Build intermediaries
node_modules/**
out/**
*.map
*.tsbuildinfo

# Rust workspace (cargo sources + build artifacts)
Cargo.lock
Cargo.toml
.cargo/**
target/**

# Sub-packages — exclude all, then re-include runtime files
packages/**
!packages/native-napi/index.js
!packages/native-napi/index.d.ts
!packages/native-napi/neko-engine.*.node

# FFmpeg dylibs (bundled by scripts/bundle-ffmpeg.js)
!packages/native-napi/*.dylib
!packages/native-napi/*.so*
!packages/native-napi/*.dll

# Include compiled output, ORT dylibs, and localization
!dist/**
!bin/**
!l10n/**
