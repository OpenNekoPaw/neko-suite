{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@neko-agent/types": ["../neko-agent/packages/agent-types/src/index.ts"],
      "@neko-agent/types/*": ["../neko-agent/packages/agent-types/src/*"],
      "@neko/shared": ["../../../neko-types/src/index.ts"],
      "@neko/shared/*": ["../../../neko-types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
