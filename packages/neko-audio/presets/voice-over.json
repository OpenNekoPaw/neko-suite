{
  "name": "Voice Over",
  "description": "Warm voice-over chain: low-cut, presence boost, gentle compression",
  "category": "voice-over",
  "effectChain": [
    {
      "effectType": "parametric-eq",
      "enabled": true,
      "params": {
        "bands": [
          { "type": "high-pass", "freq": 100, "q": 0.7 },
          { "type": "peaking", "freq": 2500, "gain": 3.0, "q": 1.2 },
          { "type": "peaking", "freq": 5000, "gain": 1.5, "q": 1.0 },
          { "type": "low-pass", "freq": 16000, "q": 0.7 }
        ]
      }
    },
    {
      "effectType": "compressor",
      "enabled": true,
      "params": {
        "threshold": -20,
        "ratio": 2.5,
        "attack": 0.005,
        "release": 0.12,
        "knee": 4,
        "makeupGain": 3
      }
    }
  ]
}
