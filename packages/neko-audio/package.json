{
  "name": "neko-audio",
  "displayName": "Neko Audio",
  "description": "Audio workstation with waveform editing, spectrum analysis, and noise reduction",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "audio",
    "waveform",
    "spectrum",
    "recording",
    "noise-reduction"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neko.audioEditor",
        "displayName": "Audio Editor",
        "selector": [
          {
            "filenamePattern": "*.{mp3,wav,ogg,flac,aac,m4a}"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "neko.audioProject",
        "displayName": "Audio Project",
        "selector": [
          {
            "filenamePattern": "*.nka"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "nekoAudio.outline",
          "name": "Audio Outline",
          "contextualTitle": "Audio Outline",
          "icon": "$(list-tree)",
          "when": "activeCustomEditorId == 'neko.audioEditor' || activeCustomEditorId == 'neko.audioProject'"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.audio.record",
        "title": "Record Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.denoise",
        "title": "Denoise Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.normalize",
        "title": "Normalize Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.showSpectrum",
        "title": "Show Spectrum Analyzer",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.trim",
        "title": "Trim Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.fadeIn",
        "title": "Apply Fade In",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.fadeOut",
        "title": "Apply Fade Out",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.new",
        "title": "%neko.audio.new.title%",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.exportAs",
        "title": "Export Audio As...",
        "category": "Neko Audio"
      }
    ],
    "menus": {
      "explorer/context": [],
      "neko.explorer.newProject": [
        {
          "command": "neko.audio.new",
          "group": "1@2"
        }
      ]
    },
    "configuration": {
      "title": "Neko Audio",
      "properties": {
        "neko.audio.sampleRate": {
          "type": "number",
          "enum": [
            44100,
            48000,
            96000
          ],
          "default": 48000,
          "description": "Default sample rate for recording"
        },
        "neko.audio.inputDevice": {
          "type": "string",
          "default": "",
          "description": "Preferred audio input device"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview && npm run copy:extension && npm run copy:webview && npm run copy:l10n",
    "compile:extension": "cd packages/extension && npm run build",
    "compile:webview": "cd packages/webview && npm run build",
    "copy:extension": "mkdir -p dist && cp packages/extension/dist/extension.js dist/extension.js",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview/assets && cp packages/webview/dist/*.html dist/webview/ 2>/dev/null || true && cp -R packages/webview/dist/assets/* dist/webview/assets/ 2>/dev/null || true",
    "copy:l10n": "mkdir -p dist/l10n && cp -R l10n/* dist/l10n/",
    "watch": "npm run compile:extension -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest --passWithNoTests",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^4.1.2"
  }
}
