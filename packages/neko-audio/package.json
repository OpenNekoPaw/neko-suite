{
  "name": "neko-audio",
  "displayName": "Neko Audio",
  "description": "Audio workstation with waveform editing, spectrum analysis, and noise reduction",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "audio",
    "waveform",
    "spectrum",
    "recording",
    "noise-reduction"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neko.audioEditor",
        "displayName": "Audio Editor",
        "selector": [
          {
            "filenamePattern": "*.{mp3,wav,ogg,flac,aac,m4a}"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "neko.audio.record",
        "title": "Record Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.denoise",
        "title": "Denoise Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.normalize",
        "title": "Normalize Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.showSpectrum",
        "title": "Show Spectrum Analyzer",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.trim",
        "title": "Trim Audio",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.fadeIn",
        "title": "Apply Fade In",
        "category": "Neko Audio"
      },
      {
        "command": "neko.audio.fadeOut",
        "title": "Apply Fade Out",
        "category": "Neko Audio"
      }
    ],
    "configuration": {
      "title": "Neko Audio",
      "properties": {
        "neko.audio.sampleRate": {
          "type": "number",
          "enum": [44100, 48000, 96000],
          "default": 48000,
          "description": "Default sample rate for recording"
        },
        "neko.audio.inputDevice": {
          "type": "string",
          "default": "",
          "description": "Preferred audio input device"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@neko/shared": "workspace:*",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
