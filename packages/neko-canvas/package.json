{
  "name": "neko-canvas",
  "displayName": "NekoCanvas",
  "description": "Canvas editor for VSCode",
  "version": "0.0.1",
  "publisher": "neko",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "canvas",
    "design",
    "assets",
    "library"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "neko.neko-engine",
    "neko.neko-tools",
    "neko.neko-preview"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "neko.canvasEditor",
        "displayName": "Canvas Editor",
        "selector": [
          {
            "filenamePattern": "*.jvc"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "neko.canvasOutline",
          "name": "%neko.canvas.outline.title%",
          "when": "activeCustomEditorId == 'neko.canvasEditor'",
          "icon": "$(list-tree)"
        }
      ]
    },
    "commands": [
      {
        "command": "neko.canvas.new",
        "title": "%neko.canvas.new.title%",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.addShape",
        "title": "Add Shape",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.updateShape",
        "title": "Update Shape",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.asset.import",
        "title": "%neko.asset.import.title%",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.asset.organize",
        "title": "Organize Assets",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.asset.search",
        "title": "Search Assets",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.addToAssetLibrary",
        "title": "%neko.addToAssetLibrary.title%",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.previewMedia",
        "title": "Preview Media",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.template.apply",
        "title": "Apply Template",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.template.save",
        "title": "Save as Template",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.deleteSelected",
        "title": "Delete Selected",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.escape",
        "title": "Cancel / Deselect",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.selectAll",
        "title": "Select All",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.undo",
        "title": "Undo",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.redo",
        "title": "Redo",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.selectNodeFromOutline",
        "title": "Select Node",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.selectConnectionFromOutline",
        "title": "Select Connection",
        "category": "NekoCanvas"
      },
      {
        "command": "neko.canvas.resetZoom",
        "title": "Reset Zoom",
        "category": "NekoCanvas"
      }
    ],
    "keybindings": [
      {
        "command": "neko.canvas.deleteSelected",
        "key": "delete",
        "when": "activeCustomEditorId == 'neko.canvasEditor'"
      },
      {
        "command": "neko.canvas.deleteSelected",
        "key": "backspace",
        "when": "activeCustomEditorId == 'neko.canvasEditor'"
      },
      {
        "command": "neko.canvas.escape",
        "key": "escape",
        "when": "activeCustomEditorId == 'neko.canvasEditor'"
      },
      {
        "command": "neko.canvas.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "activeCustomEditorId == 'neko.canvasEditor'"
      },
      {
        "command": "neko.canvas.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'neko.canvasEditor'"
      },
      {
        "command": "neko.canvas.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'neko.canvasEditor'"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "neko.canvas.new",
          "group": "navigation@10",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "neko.addToAssetLibrary",
          "group": "neko@3",
          "when": "resourceExtname =~ /\\.(mp4|mov|avi|mkv|webm|m4v|mp3|wav|ogg|m4a|aac|flac|png|jpg|jpeg|gif|webp|bmp|svg|txt|md|json|srt|vtt|ass|ssa)$/i"
        },
        {
          "command": "neko.canvas.previewMedia",
          "group": "neko@2",
          "when": "resourceExtname =~ /\\.(mp4|mov|avi|mkv|webm|m4v|ts|flv|wmv|mp3|wav|ogg|flac|aac|m4a|wma|opus)$/i"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview && npm run copy:extension && npm run copy:webview",
    "compile:extension": "cd packages/extension && npm run build",
    "compile:webview": "cd packages/webview && npm run build",
    "copy:webview": "rm -rf dist/webview && mkdir -p dist/webview/assets && cp packages/webview/dist/*.html dist/webview/ 2>/dev/null || true && cp -R packages/webview/dist/assets/* dist/webview/assets/ 2>/dev/null || true",
    "copy:extension": "mkdir -p dist && cp packages/extension/dist/extension.js dist/extension.js",
    "watch": "npm run compile:extension -- --watch",
    "lint": "eslint packages --ext ts,tsx",
    "test": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.55.0",
    "typescript": "^5.3.2",
    "vitest": "^4.0.18"
  }
}
