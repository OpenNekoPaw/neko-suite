{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@neko-agent/webview/root": ["src/renderer/webview-root-types.tsx"],
      "@/*": ["../../packages/neko-agent/packages/webview/src/*"],
      "@neko-agent/types": ["../../packages/neko-agent/packages/agent-types/src/index.ts"],
      "@neko-agent/types/*": ["../../packages/neko-agent/packages/agent-types/src/*"],
      "@neko/markdown": ["../../packages/neko-markdown/src/index.ts"],
      "@neko/markdown/*": ["../../packages/neko-markdown/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts"]
}
