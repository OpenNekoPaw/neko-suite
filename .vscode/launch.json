{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug neko-cut",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/neko-cut",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/neko-engine",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/neko-tools"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/neko-cut/dist/**/*.js",
        "${workspaceFolder}/packages/neko-engine/dist/**/*.js",
        "${workspaceFolder}/packages/neko-tools/dist/**/*.js"
      ],
      "preLaunchTask": "build:neko-cut"
    },
    {
      "name": "Debug neko-cut (CDP:9222)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/Applications/Visual Studio Code.app/Contents/MacOS/Electron",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/neko-cut",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/neko-engine",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/neko-tools"
      ],
      "preLaunchTask": "build:neko-cut"
    },
