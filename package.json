{
  "name": "neko-suite-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.29.2",
  "workspaces": [
    "packages/*",
    "packages/*/packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:ui": "turbo run build --filter=@neko/webview --filter=@neko-agent/webview --filter=@neko-canvas/webview --filter=@neko-dashboard/webview",
    "build:release": "turbo run compile --filter=neko-engine --filter=neko-tools --filter=neko-preview --filter=neko-assets --filter=neko-auth --filter=neko-agent --filter=neko-market --filter=neko-cut --filter=neko-canvas --filter=neko-dashboard --filter=neko-story --filter=neko-sketch --filter=neko-puppet --filter=neko-audio",
    "build:desktop": "pnpm --filter neko-desktop run build",
    "build:dev": "turbo run compile --filter='neko-*'",
    "build:pack-video": "turbo run compile --filter=neko-engine --filter=neko-tools --filter=neko-preview --filter=neko-assets --filter=neko-auth --filter=neko-agent --filter=neko-market --filter=neko-cut --filter=neko-canvas --filter=neko-story",
    "build:pack-2d": "turbo run compile --filter=neko-engine --filter=neko-tools --filter=neko-preview --filter=neko-assets --filter=neko-auth --filter=neko-agent --filter=neko-market --filter=neko-sketch --filter=neko-puppet",
    "build:pack-audio": "turbo run compile --filter=neko-engine --filter=neko-tools --filter=neko-preview --filter=neko-assets --filter=neko-auth --filter=neko-agent --filter=neko-market --filter=neko-audio",
    "build:neko-engine": "turbo run compile --filter=neko-engine",
    "build:neko-preview": "turbo run compile --filter=neko-preview",
    "build:neko-cut": "turbo run compile --filter=neko-cut",
    "build:neko-agent": "turbo run compile --filter=neko-agent",
    "compile:ts-vsix": "node scripts/compile-ts-vsix.mjs",
    "dev": "turbo run dev --filter=neko-cut",
    "dev:neko": "turbo run watch --filter=neko-cut",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/**/src/**/*.{ts,tsx}\" --fix",
    "lint:turbo": "turbo run lint",
    "start:desktop": "pnpm --filter neko-desktop run start",
    "test": "turbo run test --concurrency=2",
    "test:desktop": "pnpm --filter neko-desktop run test",
    "test:agent:mock": "pnpm --filter neko-agent run test:agent:mock",
    "test:agent:eval": "vitest --config vitest.agent-eval.config.mts --run && node scripts/agent-eval/all-suite-dry-run.mjs",
    "package:all": "turbo run package --filter='neko-*'",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "generate:types": "node scripts/proto-gen-ts.mjs",
    "nekoagent": "pnpm --filter @neko/cli dev",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx,json}\"",
    "check:unused": "knip",
    "check:unused:fix": "knip --fix",
    "check:legacy-debt": "node scripts/check-legacy-debt-surfaces.mjs",
    "check:legacy-debt:ledger": "node scripts/check-legacy-debt-surfaces.mjs --validate-ledger",
    "check:content-access-boundaries": "node scripts/check-content-access-boundaries.mjs",
    "check:agent-boundaries": "node scripts/check-neko-agent-boundaries.mjs",
    "check:3d-route-a-boundaries": "node scripts/check-3d-route-a-boundaries.mjs",
    "check:canvas-playback-boundary": "node scripts/check-canvas-playback-boundary.mjs",
    "check:release-channels": "node scripts/check-release-channels.mjs",
    "check:openspec": "node scripts/check-openspec.mjs",
    "check:strict-tsconfig": "node scripts/check-strict-tsconfig.mjs",
    "check:strict-extensions": "pnpm exec tsc --noEmit -p packages/neko-agent/packages/extension/tsconfig.json && pnpm exec tsc --noEmit -p packages/neko-market/packages/extension/tsconfig.json",
    "check:webview-boundaries": "node scripts/check-webview-boundaries.mjs",
    "check:quality": "pnpm check:release-channels && pnpm check:legacy-debt:ledger && pnpm check:content-access-boundaries && pnpm check:agent-boundaries && pnpm check:3d-route-a-boundaries && pnpm check:canvas-playback-boundary && pnpm check:webview-boundaries && pnpm check:strict-tsconfig && pnpm check:strict-extensions && pnpm check:openspec",
    "diagnostics:scene-render": "node scripts/scene-render-diagnostics.mjs",
    "check:deps": "depcruise packages/neko-types/src packages/neko-host/src packages/neko-client/src packages/neko-cut/packages/extension/src packages/neko-cut/packages/webview/src packages/neko-agent/packages/extension/src packages/neko-agent/packages/platform/src packages/neko-agent/packages/agent/src packages/neko-canvas/packages/webview/src packages/neko-story/packages/extension/src packages/neko-story/packages/parser/src packages/neko-preview/packages/extension/src --config",
    "check": "pnpm check:unused && pnpm check:deps",
    "ci:local": "pnpm format:check && pnpm lint && pnpm build && pnpm test -- --run && pnpm test:agent:eval && pnpm check && pnpm check:quality",
    "ci:local:rust": "cd packages/neko-engine && cargo fmt --all -- --check && cargo clippy --workspace -- -D warnings && cargo test --workspace",
    "ci:local:proto": "pnpm generate:types && git diff --exit-code packages/neko-types/src/generated/",
    "ci:act": "scripts/act-ci.sh",
    "ci:act:list": "scripts/act-ci.sh --list",
    "smoke:engine:cli": "pnpm --filter @neko-engine/host-cli run build:debug && node scripts/smoke-engine-cli.mjs",
    "smoke:engine:serve": "pnpm --filter @neko-engine/host-cli run build:debug && node scripts/smoke-engine-serve.mjs",
    "smoke:engine": "pnpm smoke:engine:cli && pnpm smoke:engine:serve",
    "smoke:webview": "node scripts/smoke-webview-builds.mjs",
    "smoke:vscode-debugger": "node scripts/smoke-vscode-debugger-skill.mjs",
    "smoke:webview:runtime": "node scripts/smoke-vscode-debugger-skill.mjs --skill vscode-extension-debugger --require-webview",
    "smoke:desktop": "pnpm --filter neko-desktop run smoke",
    "smoke": "pnpm smoke:engine && pnpm smoke:webview",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@img/sharp-wasm32": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fission-ai/openspec": "1.3.1",
    "@vitest/coverage-v8": "4.1.2",
    "@vscode/vsce": "^3.9.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.1",
    "protobufjs": "^8.6.5",
    "turbo": "^2.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "6.4.2",
    "vitest": "4.1.2",
    "ws": "8.18.3",
    "yaml": "2.9.0"
  }
}
