{
  "name": "neko-suite-monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "workspaces": [
    "packages/*",
    "packages/*/packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:ui": "turbo run build --filter=@neko/webview --filter=@neko-agent/webview --filter=@neko/canvas --filter=@neko/effects-core",
    "build:core": "turbo run compile --filter=neko-engine --filter=neko-tools",
    "build:extensions": "turbo run compile --filter='neko-*'",
    "build:neko-cut": "turbo run compile --filter=neko-cut",
    "build:neko-canvas": "turbo run compile --filter=neko-canvas",
    "build:neko-sketch": "turbo run compile --filter=neko-sketch",
    "build:neko-agent": "turbo run compile --filter=neko-agent",
    "build:neko-engine": "turbo run compile --filter=neko-engine",
    "build:neko-story": "turbo run compile --filter=neko-story",
    "build:neko-audio": "turbo run compile --filter=neko-audio",
    "build:neko-live": "turbo run compile --filter=neko-live",
    "build:neko-assets": "turbo run compile --filter=neko-assets",
    "build:neko-tools": "turbo run compile --filter=neko-tools",
    "build:neko-preview": "turbo run compile --filter=neko-preview",
    "dev": "turbo run dev --filter=neko-cut",
    "dev:neko": "turbo run watch --filter=neko-cut",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/**/src/**/*.{ts,tsx}\" --fix",
    "lint:turbo": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "generate:types": "node scripts/proto-gen-ts.mjs",
    "nekoagent": "pnpm dlx tsx packages/neko-agent/packages/cli/src/cli.ts",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@img/sharp-wasm32": "^0.34.5",
    "d3-array": "^3.2.4",
    "d3-shape": "^3.2.0",
    "mp4-muxer": "^5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vscode/vsce": "^3.7.1",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "protobufjs": "^8.0.0",
    "turbo": "^2.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
